{
  "expo": {
    "name": "SleepEasy",
    "slug": "sleep-easy-app",
    "scheme": "sleep-easy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sleepeasylogo-android.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sleepeasy.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "SleepEasy requires Bluetooth to connect to and sync data from your O2Ring device.",
        "NSBluetoothPeripheralUsageDescription": "SleepEasy requires Bluetooth access to discover nearby O2Ring devices."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/sleepeasylogo-android.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sleepeasy.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./packages/viatom-o2ring/plugin",
      "./app.plugin.js",
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "ndkVersion": "26.1.10909125",
            "packagingOptions": {
              "pickFirst": [
                "**/libreactnative.so",
                "**/libc++_shared.so"
              ]
            },
            "abiFilters": ["arm64-v8a", "x86_64"]
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1
          },
          "androidIntentFilters": [
            "*/*"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb24647a-0e66-494f-b8a2-17e2efd6656e"
      }
    }
  }
}
